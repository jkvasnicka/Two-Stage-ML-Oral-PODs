{
    "datasets_to_process": [
      "opera_features",
      "rdkit_features",
      "surrogate_pods",
      "authoritative_pods"
    ],
  
    "do_log10_target": true,
  
    "study_count_thres": 3,
  
    "surrogate_tox_data_kwargs": {
      "sheet_name": "Table S6",
      "header": [0, 1]
    },
  
    "tox_metric": "POD [mg/m3]",
  
    "effect_mapper": {
      "general non-cancer effects": "general",
      "reproductive/developmental effects": "repro_dev"
    },
  
    "opera_log10_pat": "Log",
  
    "logging_file_name": "preprocessing_log_file.txt",
  
    "comptox_log10_pat": "LOG",
  
